{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others 'npm run dev:api' 'npm run dev:queue'",
    "dev:api": "dotenv -e .env -- ts-node-dev src/api.ts",
    "dev:queue": "dotenv -e .env -- ts-node-dev src/queue.ts",
    "dev:discord": "dotenv -e .env -- ts-node-dev src/discord.ts",
    "dev:telegram": "dotenv -e .env -- ts-node-dev src/telegram.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "dotenv -e .env -- node ./dist/server.js",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^1.0.5",
    "@ai-sdk/openai": "^1.1.9",
    "@ai-sdk/provider": "^1.0.7",
    "@aws-sdk/client-s3": "3.677.0",
    "@bull-board/api": "^6.0.2",
    "@bull-board/fastify": "^6.0.2",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.1",
    "@langchain/community": "^0.3.29",
    "@langchain/core": "^0.3.38",
    "@openrouter/ai-sdk-provider": "^0.2.1",
    "@prisma/client": "^5.20.0",
    "@repo/schema": "workspace:*",
    "@telegraf/types": "^7.1.0",
    "@trpc/client": "next",
    "@trpc/server": "next",
    "ai": "^4.1.11",
    "apify-client": "^2.10.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bn.js": "^4.12.1",
    "bs58": "^5.0.0",
    "bull": "^4.16.3",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "discord.js": "^14.16.3",
    "dotenv-cli": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "he": "^1.2.0",
    "image-type": "^4.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^14.2.0",
    "openai": "^4.73.0",
    "prisma": "^5.20.0",
    "puppeteer": "^23.5.2",
    "sharp": "^0.33.5",
    "superjson": "^1.13.3",
    "telegraf": "^4.16.3",
    "twitter-api-v2": "^1.18.1",
    "typescript": "5.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@repo/db": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.5.0",
